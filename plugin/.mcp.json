{
  "mcpServers": {
    "ecp": {
      "command": "npx",
      "args": ["-y", "ecp-mcp-server@^0.5.0"],
      "env": {
        "ECP_URL": "${user_config.panel_url}",
        "ECP_ACCOUNT_USERNAME": "${user_config.username}",
        "ECP_ACCOUNT_PASSWORD": "${user_config.password}",
        "ECP_REMEMBER": "true",
        "ECP_UPLOAD_DIRS": "${user_config.upload_folder}"
      }
    }
  }
}
