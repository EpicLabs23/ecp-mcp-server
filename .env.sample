# Base URL of the target ECP instance's own API (ecp-go), NOT EHM-API.
# e.g. https://haargodev.com:2324/api
ECP_API_BASE_URL=

# The hosting account this MCP server logs in as. One server = one account.
ECP_ACCOUNT_USERNAME=
ECP_ACCOUNT_PASSWORD=

# If true, requests a 30-day refresh token instead of the 24h default.
ECP_REMEMBER=false

# Where the local append-only audit log (every tool call) is written.
# Defaults to ./audit.log next to this file if unset.
ECP_MCP_AUDIT_LOG_PATH=

# Dev-only escape hatch: disables TLS certificate verification for this
# process (e.g. a self-signed dev ECP instance). Leave unset/false for any
# real account - this affects every outgoing HTTPS request the process
# makes, so never point a server configured this way at anything you
# haven't deliberately chosen to trust.
ECP_TLS_INSECURE=false
